source leaprc.protein.ff14SB
source leaprc.gaff
source leaprc.water.tip3p

loadamberparams RESIDUE_NAME.frcmod
RESIDUE_NAME = loadmol2 RESIDUE_NAME.mol2

complex = loadpdb INPUT_PDB

center complex
set complex box {150 150 150}
charge complex

savepdb complex OUTPUT_PREFIX.pdb
saveamberparm complex OUTPUT_PREFIX.parm7 OUTPUT_PREFIX.rst7

quit

